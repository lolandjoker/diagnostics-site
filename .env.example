# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Сервер (docker-compose.yml) ---
# Домен для HTTPS-сертификата
SITE_DOMAIN=taromba.com
# Прежние адреса сайта — Caddy переадресует их на SITE_DOMAIN с тем же путём (через запятую)
OLD_SITE_DOMAIN=diagnostics-free.com, www.diagnostics-free.com
# Пароль базы: только буквы и цифры, сгенерируйте командой  openssl rand -hex 24
# Адреса базы и Redis для сайта docker-compose собирает сам — их здесь не задавать.
POSTGRES_PASSWORD=

# Вход в админку (/admin). Пароль — не короче 12 символов, секрет — не короче 32.
# setup-server.sh генерирует оба, если их нет. Смена любого из них завершает все сессии.
ADMIN_PASSWORD=
SESSION_SECRET=

# Голосовые звонки в чате (сервис turn). setup-server.sh генерирует секрет и определяет адрес сам.
# TURN_SECRET — общий секрет сайта и TURN-сервера: openssl rand -hex 32
# TURN_IP — публичный IPv4 сервера (не внутренний): на нём TURN принимает звонки
TURN_SECRET=
TURN_IP=

# Приложение в Telegram-боте (необязательно). Токен выдаёт @BotFather. С ним сайт при запуске сам
# настраивает бота (кнопка «Открыть» в меню, ответ на /start) и шлёт клиентам из бота уведомления
# об ответах эксперта. Адрес сайта для бота берётся из SITE_DOMAIN.
TELEGRAM_BOT_TOKEN=

# Владельцы сайта — Telegram ID через запятую: команда /admin в боте присылает им вход в админку
# (ссылка на 10 минут, в Telegram и в браузере). Узнать свой ID — @userinfobot.
OWNER_TELEGRAM_IDS=

# Почта (lib/mail.ts) — письмо «Подробный разбор готов» тем, кто указал почту в чате. UniSender Go:
# SMTP_HOST=smtp.go1.unisender.ru, SMTP_USER — id пользователя, SMTP_PASS — API-ключ. Домен отправителя
# подтвердить в UniSender Go (записи SPF и DKIM в DNS), иначе письма уйдут в спам. Пусто — почта выключена,
# поле почты в чате не показывается.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Таромба <noreply@taromba.com>"

# --- Разработка на своём компьютере ---
# Без DATABASE_URL сайт берёт встроенный PostgreSQL (PGlite) в apps/web/.data — Docker не нужен.
# Для разработки положите ADMIN_PASSWORD и SESSION_SECRET в apps/web/.env.local
# DATABASE_URL=postgres://diag:diag@localhost:5432/diag
# REDIS_URL=redis://localhost:6379

# Расшифровки «Клуба Таромбы» (карта дня) пишет Claude Opus 5.5. Пусто — заготовленные тексты карт.
# Ключ — отдельный, с лимитом расходов: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
