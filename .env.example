# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Публичный адрес сайта
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# База данных и Redis (для Docker Compose значения ниже подходят как есть)
DATABASE_URL=postgres://diag:diag@localhost:5432/diag
REDIS_URL=redis://localhost:6379

# Пароль базы для контейнера postgres (только для docker-compose)
POSTGRES_PASSWORD=diag

# Домен для Caddy (боевой сервер)
SITE_DOMAIN=diagnostics-free.com
