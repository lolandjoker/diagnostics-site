# Caddy сам получает и продлевает HTTPS-сертификат для домена.
# Домен берётся из переменной SITE_DOMAIN (файл .env на сервере).

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	reverse_proxy web:3000
}

# Прежние адреса сайта (OLD_SITE_DOMAIN в .env, через запятую с www) — насовсем на новый домен,
# с тем же путём: старые ссылки, закладки и кнопки в Telegram продолжают работать.
# Не задано — заглушка http://old.localhost: ни на что не отвечает и сертификат не запрашивает.
{$OLD_SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
